--===================== INSTANT KILL (copiada tal cual del original, fn19) =====================
local function InstantKill(arg)
	for _, v22 in ipairs(arg) do
		setSimRadius(math.huge)

		if v22:FindFirstChild("Humanoid") then
			v22.Humanoid.Health = 0
		end

		if v22:FindFirstChild("HumanoidRootPart") then
			v22.HumanoidRootPart.CanCollide = false
		end
	end
end

--===================== TWEEN =====================
local tweenState = { Counter = 0, StopFlag = false }

local function stopTween()
	tweenState.StopFlag = true
	tweenState.Counter += 1
end

local function topos(target)
	if not isAlive() then return end
	local cf
	if typeof(target) == "Vector3" then
		cf = CFrame.new(target)
	elseif typeof(target) == "CFrame" then
		cf = target
	elseif typeof(target) == "Instance" then
		if target:IsA("BasePart") then
			cf = target.CFrame
		else
			local p = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
			if p then cf = p.CFrame end
		end
	end
	if not cf then return end

	if (humanoidRootPart.Position - cf.Position).Magnitude > 3500 then
		FireInvoke("requestEntrance", cf.Position)
		task.wait(0.1)
		if humanoidRootPart then
			humanoidRootPart.CFrame = humanoidRootPart.CFrame + Vector3.new(0, 20)
		end
		task.wait(0.5)
	end

	tweenState.Counter += 1
	local myCounter = tweenState.Counter
	tweenState.StopFlag = false

	task.spawn(function()
		if not humanoidRootPart then return end
		local startCF = humanoidRootPart.CFrame
		local magnitude = (cf.Position - startCF.Position).Magnitude
		if magnitude <= 5 then return end
		local now = tick()
		local travelled = 0
		while tweenState.Counter == myCounter and not tweenState.StopFlag do
			if not isAlive() then break end
			if not humanoidRootPart or not humanoidRootPart.Parent then break end
			local now2 = tick()
			local dt = now2 - now
			travelled += Config.TweenSpeed * dt
			local alpha = math.clamp(travelled / magnitude, 0, 1)
			humanoidRootPart.CFrame = startCF:Lerp(cf, alpha)
			if alpha >= 1 or (cf.Position - humanoidRootPart.Position).Magnitude <= 10 then
				humanoidRootPart.CFrame = cf
				break
			end
			task.wait()
			now = now2
		end
	end)
end

--===================== RAID HELPERS =====================
local function getRaidTimer()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local main = pg and pg:FindFirstChild("Main")
	local top = main and main:FindFirstChild("TopHUDList")
	return top and top:FindFirstChild("RaidTimer")
end

local function GetRaidIslands()
	local locations = worldOrigin:FindFirstChild("Locations")
	if not locations then return nil end
	for i = 5, 1, -1 do
		local name = "Island " .. i
		for _, child in ipairs(locations:GetChildren()) do
			if child.Name == name and child:IsA("Part") and humanoidRootPart
				and (humanoidRootPart.Position - child.Position).Magnitude < 3500 then
				return child
			end
		end
	end
end

local function GetCurrentRaidIslandIndex()
	local island = GetRaidIslands()
	if island and island.Name:match("Island (%d+)") then
		return tonumber(island.Name:match("Island (%d+)"))
	end
	return nil
end

local function IsReady(model)
	if not model or not model.Parent or not model:IsDescendantOf(Workspace) then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local function HayEnemigosVivos()
	for _, child in ipairs(enemies:GetChildren()) do
		local hum = child:FindFirstChild("Humanoid")
		if hum and hum.Health > 0 then
			return true
		end
	end
	return false
end

local function EnemigosEnRango(radius)
	local list = {}
	if not humanoidRootPart then return list end
	for _, child in ipairs(enemies:GetChildren()) do
		local hum = child:FindFirstChild("Humanoid")
		local hrp = child:FindFirstChild("HumanoidRootPart") or child.PrimaryPart
		if hum and hrp and (hrp.Position - humanoidRootPart.Position).Magnitude < (radius or 150) then
			table.insert(list, child)
		end
	end
	return list
end

--===================== ATAQUE / REMATE =====================
local validator2 = remotes:WaitForChild("Validator2")
local reRegisterAttack = net:WaitForChild("RE/RegisterAttack")
local RegisterHit = require(modules.Net):RemoteEvent("RegisterHit", true)

local function clave()
	return tostring(LocalPlayer.UserId):sub(2, 4) .. tostring(coroutine.running()):sub(11, 15)
end

local function ArmaValida()
	local tool = character and character:FindFirstChildOfClass("Tool")
	if tool and table.find({ "Melee", "Sword", "Blox Fruit" }, tool.ToolTip or "") then
		return tool
	end
	for _, tipo in ipairs({ "Melee", "Sword", "Blox Fruit" }) do
		if EquipWeapon(tipo) then
			task.wait(0.05)
			tool = character and character:FindFirstChildOfClass("Tool")
			if tool then return tool end
		end
	end
	return nil
end

local function GetHits(radius)
	local result = {}
	if not humanoidRootPart then return result end
	local maxHits = humanoidRootPart:FindFirstChild("Buddha") and 10 or 2
	local candidates = {}
	for _, mob in ipairs(enemies:GetChildren()) do
		if IsReady(mob) then
			local hrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
			if hrp then
				local dist = (hrp.Position - humanoidRootPart.Position).Magnitude
				if dist <= (radius or 50) then
					table.insert(candidates, { mob, hrp, dist })
				end
			end
		end
	end
	table.sort(candidates, function(a, b) return a[3] < b[3] end)
	for i = 1, math.min(#candidates, maxHits) do
		table.insert(result, { candidates[i][1], candidates[i][2] })
	end
	return result
end

local function FastAttack()
	local tool = character and character:FindFirstChildOfClass("Tool")
	if not tool then return end
	local toolTip = tool.ToolTip
	if toolTip == "Gun" then return end
	if not table.find({ "Melee", "Blox Fruit", "Sword" }, toolTip) then return end

	local hits = GetHits(toolTip == "Blox Fruit" and 100 or 50)
	if #hits == 0 then return end

	reRegisterAttack:FireServer(0)
	local targets, first = {}, nil
	for _, h in ipairs(hits) do
		table.insert(targets, h)
		first = first or h[2]
	end
	if first and RegisterHit then
		RegisterHit:FireServer(first, targets, nil, nil, clave())
	end
end

--===================== REMATE: el hit real que confirma la muerte =====================
-- El InstantKill solo deja la vida en 0, pero si el mob no es tuyo el servidor no
-- confirma la muerte y queda "a poca vida". Esto le manda el golpe real a TODOS
-- los mobs de la isla de un solo tiro, para que el servidor los de por muertos.
local function RematarIsla()
	local tool = ArmaValida()
	if not tool or not humanoidRootPart then return end

	AutoHaki()

	local targets, first = {}, nil
	for _, mob in ipairs(EnemigosEnRango(200)) do
		local hrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
		if hrp then
			table.insert(targets, { mob, hrp })
			first = first or hrp
		end
	end
	if #targets == 0 or not first then return end

	pcall(function() reRegisterAttack:FireServer(0) end)
	pcall(function() RegisterHit:FireServer(first, targets, nil, nil, clave()) end)

	-- ataque nativo de respaldo (por si el hit del servidor se rechaza)
	local lc = tool:FindFirstChild("LeftClickRemote")
	if lc then
		pcall(function() lc:FireServer(Vector3.new(0.01, -500, 0.01), 1, true) end)
	end
end

local function SimpleAttack(target)
	if not target or not target.Parent then return end
	local hrp = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
	if not hrp then return end
	topos(CFrame.new(hrp.Position + Vector3.new(0, 15, 0)))
	AutoHaki()
	EquipWeapon()
	FastAttack()
end

