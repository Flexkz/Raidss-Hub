local FRUIT_RANK = {
	["Rocket-Rocket"] = 1, ["Spin-Spin"] = 2, ["Blade-Blade"] = 3, ["Chop-Chop"] = 3,
	["Spring-Spring"] = 4, ["Bomb-Bomb"] = 5, ["Smoke-Smoke"] = 6, ["Spike-Spike"] = 7,
	["Flame-Flame"] = 8, ["Falcon-Falcon"] = 9, ["Ice-Ice"] = 10, ["Sand-Sand"] = 11,
	["Dark-Dark"] = 12, ["Diamond-Diamond"] = 13, ["Light-Light"] = 14, ["Ghost-Ghost"] = 15,
	["Rubber-Rubber"] = 16, ["Barrier-Barrier"] = 17, ["Magma-Magma"] = 18,
}

local function GetLowestFruit()
	local ok, result = pcall(function()
		return net:RemoteFunction("GetAllItemValues"):InvokeServer()
	end)
	if not ok or not result or type(result) ~= "table" then return nil end

	local owned = {}
	for _, item in ipairs(result) do
		if item.Key == "IsOwned" and item.Value == true then
			owned[item.ItemId] = true
		end
	end

	local lowest, found = math.huge, nil
	for itemId in pairs(owned) do
		local ok2, res2 = pcall(function() return ItemConfig.match(itemId) end)
		if ok2 and res2 and res2.isOk and res2:isOk() then
			local unwrapped = res2:unwrap()
			if unwrapped and unwrapped.Index and unwrapped.Index.IdType == "PhysicalMoveset" then
				local label = tostring(unwrapped.Index.DebugLabel or unwrapped.Index.Name or "")
				local name = label:match("^(.-)%s*%[") or label
				local storageKey = tostring(unwrapped.Index.StorageKey or name)
				local rank = FRUIT_RANK[name] or FRUIT_RANK[storageKey]
				if rank and rank < lowest then
					found = { Name = name, StorageKey = storageKey, ItemId = itemId, Rank = rank }
					lowest = rank
				end
			end
		end
	end
	return found
end

--===================== AUTO RAID (SOLO SE MUEVE DE ISLA) =====================
local RaidToggle

local function AutoRaidStep()
	if Config.Autostopraid and fragments.Value >= (tonumber(Config.FragsCap) or 10000) then
		Config.AutoRaid = false
		if RaidToggle then RaidToggle:Set(false) end
		Rayfield:Notify({ Title = "Raid Hub", Content = "Frags cap alcanzado - Auto Raid detenido.", Duration = 5 })
		return
	end

	local RaidTimer = getRaidTimer()
	if not RaidTimer then return end

	if RaidTimer.Visible and LocalPlayer:GetAttribute("IslandRaiding") then
		if Config.InstantKillAll then
			-- El loop de arriba ya mata y remata todo.
			-- Aqui SOLO se hace el unico tween: cambiar de isla cuando ya no queda nadie vivo.
			if not HayEnemigosVivos() then
				local island = GetRaidIslands()
				if island then
					topos(CFrame.new(island.Position + Vector3.new(0, 12, 0)))
				end
			end
		else
			local objetivo
			for _, child in ipairs(enemies:GetChildren()) do
				local hum = child:FindFirstChild("Humanoid")
				local hrp = child:FindFirstChild("HumanoidRootPart")
				if hum and hrp and hum.Health > 0 and LocalPlayer:DistanceFromCharacter(hrp.Position) < 500 then
					objetivo = child
					break
				end
			end

			if objetivo then
				SimpleAttack(objetivo)
			else
				local island = GetRaidIslands()
				if island then
					topos(CFrame.new(island.Position + Vector3.new(0, 12, 0)))
				end
			end
		end
	elseif CheckToolName("Special Microchip") and not RaidTimer.Visible
		and not GetRaidIslands() and not LocalPlayer:GetAttribute("IslandRaiding") then
		if isSea2 and map:FindFirstChild("CircleIsland") then
			topos(CFrame.new(Vector3.new(-6522, 308, -4658)))
			if humanoidRootPart and (humanoidRootPart.Position - Vector3.new(-6522, 308, -4658)).Magnitude <= 5 then
				pcall(function() fireclickdetector(map.CircleIsland.RaidSummon2.Button.Main.ClickDetector) end)
			end
		elseif isSea3 and map:FindFirstChild("Boat Castle") then
			topos(CFrame.new(Vector3.new(-5073, 315, -3153)))
			if humanoidRootPart and (humanoidRootPart.Position - Vector3.new(-5073, 315, -3153)).Magnitude <= 5 then
				pcall(function() fireclickdetector(map["Boat Castle"].RaidSummon2.Button.Main.ClickDetector) end)
			end
		end
	elseif Config.SelectRaid and Config.AutoBuyChip and not CheckToolName("Special Microchip") then
		if Config.AutoUnstoreBelowFruit and not Checkfruit() and not LocalPlayer:GetAttribute("IslandRaiding") then
			local lowest = GetLowestFruit()
			if lowest then
				FireInvoke("LoadFruit", lowest.StorageKey or lowest.Name)
				task.wait(0.5)
				local fruit = Checkfruit()
				if fruit and character then
					local tool = LocalPlayer.Backpack:FindFirstChild(fruit)
					if tool then humanoid:EquipTool(tool) end
				end
			end
		elseif not LocalPlayer:GetAttribute("IslandRaiding") then
			local fruit = Checkfruit()
			if fruit and character then
				local tool = LocalPlayer.Backpack:FindFirstChild(fruit)
				if tool then humanoid:EquipTool(tool) end
			end
			FireInvoke("RaidsNpc", "Select", Config.SelectRaid)
			task.wait(1)
		else
			task.wait(1)
		end
	end
end

--===================== DUNGEON HELPERS =====================
local function GetDungeonProps(island)
	if not island or not island:FindFirstChild("Props") then return nil end
	for _, v in ipairs(island.Props:GetChildren()) do
		if v:GetAttribute("KitsuneMarkActive") == true or v:GetAttribute("Speed") == 5 then
			return v
		end
	end
	return nil
end

local function GetDungeonIslands()
	local dungeon = map:FindFirstChild("Dungeon")
	if not dungeon then return nil end
	local closest, closestIndex, best = nil, 0, math.huge
	for i = 1, 100 do
		local island = dungeon:FindFirstChild(tostring(i))
		if island then
			local pos = island:GetPivot().Position
			local mag = (humanoidRootPart.Position - pos).Magnitude
			local ext = island:GetExtentsSize()
			if mag < math.max(ext.X, ext.Y, ext.Z) / 2 + 100 and mag < best then
				best, closest, closestIndex = mag, island, i
			end
		end
	end
	if not closest then return nil end
	if not dungeon:FindFirstChild(tostring(closestIndex + 1)) then return nil end
	if closest:FindFirstChild("ExitTeleporter") and closest.ExitTeleporter:FindFirstChild("Root") then
		return closest.ExitTeleporter.Root
	end
	return nil
end

local dungeonLast = 0

local function AutoDungeonFullStep()
	local dungeon = map:FindFirstChild("Dungeon")
	if not dungeon then return end

	local function getClosest()
		local position = humanoidRootPart.Position
		local best, bestIdx, bestDist = nil, 0, math.huge
		for i = 1, 100 do
			local isl = dungeon:FindFirstChild(tostring(i))
			if isl then
				local p = isl:GetPivot().Position
				local d = math.sqrt((position.X - p.X) ^ 2 + (position.Z - p.Z) ^ 2)
				local ext = isl:GetExtentsSize()
				if d < math.max(ext.X, ext.Z) / 2 + 300 and d < bestDist then
					bestDist, best, bestIdx = d, isl, i
				end
			end
		end
		return best, bestIdx
	end

	local function getMobs(isl)
		local list = {}
		if not isl then return list end
		local ext = isl:GetExtentsSize()
		local radius = math.max(ext.X, ext.Z) / 2 + 300
		local p = isl:GetPivot().Position
		for _, child in ipairs(enemies:GetChildren()) do
			if child:IsDescendantOf(Workspace) and child:FindFirstChild("Humanoid")
				and child.Humanoid.Health > 0 and child:FindFirstChild("HumanoidRootPart")
				and child.Name ~= "Blank Buddy" and not string.find(string.lower(child.Name), "shadow") then
				local cp = child.HumanoidRootPart.Position
				if math.sqrt((p.X - cp.X) ^ 2 + (p.Z - cp.Z) ^ 2) < radius then
					table.insert(list, child)
				end
			end
		end
		return list
	end

	local island, idx = getClosest()
	local mobs = getMobs(island)

	if Config.AutoDungeonShrine and idx == dungeonLast then
		local prop = GetDungeonProps(island)
		if prop then
			local pp = prop:GetPivot().Position
			if LocalPlayer:DistanceFromCharacter(pp) > 10 then
				topos(CFrame.new(pp + Vector3.new(0, 5, 0)))
			else
				AutoHaki()
				EquipWeapon()
				FastAttack()
			end
			return
		end
	end

	if #mobs == 0 then
		local t0 = tick()
		while true do
			task.wait(0.5)
			island, idx = getClosest()
			mobs = getMobs(island)
			if #mobs > 0 or tick() - t0 > 2 then break end
		end
	end

	if #mobs > 0 then
		dungeonLast = idx
		local target = mobs[1]
		local tool = character and character:FindFirstChildOfClass("Tool")
		local y = (target:FindFirstChild("HumanoidRootPart") and target.HumanoidRootPart.Position.Y or 0)
			> (island and island:GetPivot().Position.Y or 0) + 100 and 0
			or (tool and tool.ToolTip == "Blox Fruit" and 20 or 30)
		if target.Parent and target:FindFirstChild("HumanoidRootPart") then
			topos(CFrame.new(target.HumanoidRootPart.Position + Vector3.new(0, y, 0)))
			EquipWeapon()
			AutoHaki()
			FastAttack()
		end
	elseif island then
		local exitPart = GetDungeonIslands()
		if exitPart and LocalPlayer:DistanceFromCharacter(exitPart.Position) > 20 then
			topos(CFrame.new(exitPart.Position + Vector3.new(0, 10, 0)))
			task.wait(1)
		end
	end
end

