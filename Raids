local storeDebounce = {}
local function AutoStoreFruitStep()
	for _, container in ipairs({
		LocalPlayer:FindFirstChild("Backpack"),
		character,
		Workspace:FindFirstChild("Characters") and Workspace.Characters:FindFirstChild(LocalPlayer.Name),
	}) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and string.find(child.Name, "Fruit") then
					local original = child:GetAttribute("OriginalName") or child.Name:match("^(.-)%-") or child.Name
					if tick() - (storeDebounce[original] or 0) > 45 then
						local res = FireInvoke("StoreFruit", original, child)
						task.wait(0.3)
						if not child:IsDescendantOf(game) or child.Parent == nil or res == true then
							storeDebounce[original] = nil
						else
							storeDebounce[original] = tick()
						end
					end
				end
			end
		end
	end
end

local function TweenfruitStep()
	local closest, best = nil, math.huge
	for _, child in ipairs(Workspace:GetChildren()) do
		if child:IsA("Model") and child.Name:find("Fruit") then
			local handle = child:FindFirstChild("Handle") or child:FindFirstChildWhichIsA("BasePart")
			if handle and humanoidRootPart then
				local mag = (handle.Position - humanoidRootPart.Position).Magnitude
				if mag < best then best, closest = mag, handle end
			end
		end
	end
	if closest then
		topos(closest.CFrame)
	elseif Config.HopIfNoFruit then
		LocalPlayer.PlayerGui.Main.TopHUDList.RaidTimer.Visible = LocalPlayer.PlayerGui.Main.TopHUDList.RaidTimer.Visible
	end
end

local fruitSeen = {}
local function FruitCheckStep()
	for _, child in ipairs(Workspace:GetChildren()) do
		if child:IsA("Model") and string.find(child.Name, "Fruit") then
			local name = child.Name == "Fruit" and "Spawned Unknown Fruit" or child.Name
			if not fruitSeen[child] then
				fruitSeen[child] = true
				Rayfield:Notify({ Title = "Blox Fruit Spawned", Content = name .. " aparecio en el mapa!", Duration = 12 })
			end
		end
	end
end

local function AutoCardsDungeonStep()
	local cards = Config.CardsSelection
	if not cards then return end
	local list = type(cards) == "table" and cards or { cards }
	if #list == 0 then return end
	for _, desc in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
		if desc:IsA("TextLabel") and desc.Name == "DisplayName" and desc.Text then
			local text = string.lower(desc.Text:gsub("<[^>]+>", ""))
			for _, card in ipairs(list) do
				if string.find(text, string.lower(card)) then
					local parent = desc.Parent
					if parent and parent.Activated then
						firesignal(parent.Activated)
						return
					end
				end
			end
		end
	end
end

local function AutoLawRaidStep()
	if CheckToolName("Order") then
		local objetivo = nil
		for _, child in ipairs(enemies:GetChildren()) do
			if child.Name == "Order" and child:FindFirstChild("Humanoid") and child.Humanoid.Health > 0 then
				objetivo = child
				break
			end
		end
		if objetivo then
			SimpleAttack(objetivo)
		else
			topos(CFrame.new(-6300, 16, -4997))
		end
		return
	end
	if not CheckToolName("Microchip") then
		FireInvoke("BlackbeardReward", "Microchip", "2")
	else
		topos(CFrame.new(Vector3.new(-5544, 229, -5938)))
		if humanoidRootPart and (humanoidRootPart.Position - Vector3.new(-5544, 229, -5938)).Magnitude <= 5 then
			pcall(function() fireclickdetector(map.CircleIsland.RaidSummon.Button.Main.ClickDetector) end)
		end
	end
end

--===================== SCHEDULER =====================
local Scheduler = {}
local function AddLoop(flag, func, interval)
	table.insert(Scheduler, { Flag = flag, Func = func, Interval = interval or 0.1, Last = 0 })
end

AddLoop("AutoRaid", AutoRaidStep, 0.1)
AddLoop("AutoAwaken", AutoAwakenStep, 0.5)
AddLoop("Random_Auto", RandomAutoStep, 0.5)
AddLoop("AutoStoreFruit", AutoStoreFruitStep, 1)
AddLoop("Tweenfruit", TweenfruitStep, 0.1)
AddLoop("FruitCheck", FruitCheckStep, 1)
AddLoop("AutoCardsDungeon", AutoCardsDungeonStep, 0.3)
AddLoop("AutoDungeonFull", AutoDungeonFullStep, 0.1)
AddLoop("AutoLawRaid", AutoLawRaidStep, 0.2)

task.spawn(function()
	while true do
		local now = tick()
		for _, loop in ipairs(Scheduler) do
			if Config[loop.Flag] and now - loop.Last >= loop.Interval then
				loop.Last = now
				pcall(loop.Func)
			end
		end
		task.wait(0.05)
	end
end)

