--===================== HELPERS =====================
local function isAlive()
	return humanoidRootPart and humanoidRootPart.Parent and humanoid and humanoid.Health > 0
end

local function CheckToolName(name)
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if character then
		return character:FindFirstChild(name) or (backpack and backpack:FindFirstChild(name))
	end
end

local function Checkfruit()
	local lists = {}
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then table.insert(lists, backpack:GetChildren()) end
	if character then table.insert(lists, character:GetChildren()) end
	for _, list in ipairs(lists) do
		for _, item in pairs(list) do
			if item:IsA("Tool") then
				if item:FindFirstChild("EatRemote") or item:FindFirstChild("DropRemote")
					or item:GetAttribute("IsPhysical") or item:GetAttribute("Fruit")
					or (item.ToolTip ~= "Blox Fruit" and string.find(item.Name, "Fruit")) then
					return item.Name
				end
			end
		end
	end
	return nil
end

local function EquipWeapon(weaponType)
	local selectWeapon = weaponType or "Melee"
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if not backpack or not humanoid then return end
	for _, child in ipairs(backpack:GetChildren()) do
		if child:IsA("Tool") and child.ToolTip == selectWeapon then
			humanoid:EquipTool(child)
			return true
		end
	end
end

local function AutoHaki()
	if not character then return end
	if not character:HasTag("Buso") and beli.Value >= 25000 then
		FireInvoke("BuyHaki", "Buso")
	elseif character:HasTag("Buso") and not character:FindFirstChild("HasBuso") then
		FireInvoke("Buso")
	end
end

